{{!
    @template mod_gepeminfotutoria/tutoria_page

    Main page template. Renders the student view (Meu polo + toggle) or the
    full view depending on the viewer's role.
}}
<div class="mod-gepemin-info-tutoria">

{{#isstudent}}
<div class="uit-switcher-shell" data-region="gepeminfotutoria-switcher">
    <div class="uit-switcher-top">
        <div class="uit-toggle" role="tablist" aria-label="{{#str}} alternarvisualizacao, gepeminfotutoria {{/str}}">
            <button type="button" role="tab" aria-selected="true" data-view="mine" class="uit-toggle-btn">
                {{#str}} meupolo, gepeminfotutoria {{/str}}
            </button>
            <button type="button" role="tab" aria-selected="false" data-view="all" class="uit-toggle-btn">
                {{#str}} listacompleta, gepeminfotutoria {{/str}}
            </button>
        </div>
    </div>

    <div class="uit-stage">
        <div class="uit-view uit-view--active" data-panel="mine">
            <div class="uit-student-cover">
                <aside class="uit-green-panel uit-student-side">
                    <div class="uit-polo-name">
                        <div class="uit-polo-label">{{#str}} seupolo, gepeminfotutoria {{/str}}</div>
                        <div class="uit-polo-value">
                            {{#has_polo}}{{polo_name}}{{/has_polo}}
                            {{^has_polo}}{{#str}} sempoloidentificado, gepeminfotutoria {{/str}}{{/has_polo}}
                        </div>
                    </div>
                </aside>

                <div class="uit-student-content">
                    {{^has_polo}}
                    <p class="uit-empty">{{nopolohelp}}</p>
                    {{/has_polo}}
                    <div class="uit-team-line">
                        <article class="uit-card">
                            <h2 class="uit-role-title">{{mine_mediation_label}}</h2>
                            {{#mine_has_mediation}}
                            <div class="uit-people-list">
                                {{#mine_mediation}}
                                {{> mod_gepeminfotutoria/person_item_compact }}
                                {{/mine_mediation}}
                            </div>
                            {{/mine_has_mediation}}
                            {{^mine_has_mediation}}
                            <p class="uit-empty">{{mine_empty_mediation_message}}</p>
                            {{/mine_has_mediation}}
                        </article>
                        <article class="uit-card">
                            <h2 class="uit-role-title">{{mine_presential_label}}</h2>
                            {{#mine_has_presential}}
                            <div class="uit-people-list">
                                {{#mine_presential}}
                                {{> mod_gepeminfotutoria/person_item_compact }}
                                {{/mine_presential}}
                            </div>
                            {{/mine_has_presential}}
                            {{^mine_has_presential}}
                            <p class="uit-empty">{{mine_empty_presential_message}}</p>
                            {{/mine_has_presential}}
                        </article>
                    </div>
                </div>
            </div>
        </div>

        <div class="uit-view" data-panel="all">
            {{> mod_gepeminfotutoria/full_view }}
        </div>
    </div>
</div>
{{/isstudent}}

{{^isstudent}}
{{> mod_gepeminfotutoria/full_view }}
{{/isstudent}}

</div>
{{#js}}
require(['mod_gepeminfotutoria/view_toggle'], function(module) { module.init(); });
{{/js}}

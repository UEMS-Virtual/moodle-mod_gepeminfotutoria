{{!
    @template mod_gepeminfortutoria/tutoria_page

    Main page template. Renders the student view (Meu polo + toggle) or the
    full view depending on the viewer's role.
}}
<div class="mod-gepemin-info-tutoria">

{{#isstudent}}
<div class="uit-switcher-shell" data-region="gepeminfortutoria-switcher">
    <div class="uit-switcher-top">
        <div class="uit-toggle" role="tablist" aria-label="{{#str}} alternarvisualizacao, gepeminfortutoria {{/str}}">
            <button type="button" role="tab" aria-selected="true" data-view="mine" class="uit-toggle-btn">
                {{#str}} meupolo, gepeminfortutoria {{/str}}
            </button>
            <button type="button" role="tab" aria-selected="false" data-view="all" class="uit-toggle-btn">
                {{#str}} listacompleta, gepeminfortutoria {{/str}}
            </button>
        </div>
    </div>

    <div class="uit-stage">
        <div class="uit-view uit-view--active" data-panel="mine">
            <div class="uit-student-cover">
                <aside class="uit-green-panel uit-student-side">
                    <div>
                        <div class="uit-big-title">{{supporttitle}}</div>
                    </div>
                    <div class="uit-polo-name">
                        <div class="uit-polo-label">{{#str}} seupolo, gepeminfortutoria {{/str}}</div>
                        <div class="uit-polo-value">
                            {{#has_polo}}{{polo_name}}{{/has_polo}}
                            {{^has_polo}}{{#str}} sempoloidentificado, gepeminfortutoria {{/str}}{{/has_polo}}
                        </div>
                    </div>
                </aside>

                <div class="uit-student-content">
                    {{^has_polo}}
                    <p class="uit-empty">{{nopolohelp}}</p>
                    {{/has_polo}}
                    <div class="uit-team-line">
                        <article class="uit-card">
                            <h2 class="uit-role-title">{{mine_tutor_label}}</h2>
                            {{#mine_has_tutors}}
                            <div class="uit-people-list">
                                {{#mine_tutors}}
                                {{> mod_gepeminfortutoria/person_item_compact }}
                                {{/mine_tutors}}
                            </div>
                            {{/mine_has_tutors}}
                            {{^mine_has_tutors}}
                            <p class="uit-empty">{{mine_empty_tutors_message}}</p>
                            {{/mine_has_tutors}}
                        </article>
                    </div>
                </div>
            </div>
        </div>

        <div class="uit-view" data-panel="all">
            {{> mod_gepeminfortutoria/full_view }}
        </div>
    </div>
</div>
{{/isstudent}}

{{^isstudent}}
{{> mod_gepeminfortutoria/full_view }}
{{/isstudent}}

</div>
{{#js}}
require(['mod_gepeminfortutoria/view_toggle'], function(module) { module.init(); });
{{/js}}

{{!
    @template mod_gepeminfotutoria/full_view

    Full view — shows all tutoring contacts with their polos.
    Used for non-student roles and as the "Lista completa" panel for students.

    Context variables (subset of tutoria_page context):
    * all_tutors      - array of member items
    * all_has_tutors  - bool
}}
<div class="uit-full-view">
    <header class="uit-green-panel uit-full-hero">
        <div class="uit-big-title">{{#str}} equipetutoria, gepeminfotutoria {{/str}}</div>
        {{#has_full_intro}}
        <div class="uit-full-intro">{{{full_intro}}}</div>
        {{/has_full_intro}}
    </header>

    <div class="uit-full-content">
        <section class="uit-full-panel">
            <h2 class="uit-role-title">{{#str}} tutoria, gepeminfotutoria {{/str}}</h2>
            {{#all_has_tutors}}
            <div class="uit-people-list">
                {{#all_tutors}}
                {{> mod_gepeminfotutoria/person_item_full }}
                {{/all_tutors}}
            </div>
            {{/all_has_tutors}}
            {{^all_has_tutors}}
            <p class="uit-empty">{{all_empty_tutors_message}}</p>
            {{/all_has_tutors}}
        </section>
    </div>
</div>

{{!
    @template mod_gepeminfotutoria/full_view

    Full view — shows mediation and presential tutoria contacts.
    Used for non-student roles and as the "Lista completa" panel for students.
}}
<div class="uit-full-view">
    <header class="uit-green-panel uit-full-hero">
        <div class="uit-big-title">{{#str}} equipetutoria, gepeminfotutoria {{/str}}</div>
        {{#has_full_intro}}
        <div class="uit-full-intro">{{{full_intro}}}</div>
        {{/has_full_intro}}
    </header>

    <div class="uit-full-content">
        <section class="uit-full-panel">
            <h2 class="uit-role-title">{{#str}} mediacaopedagogica, gepeminfotutoria {{/str}}</h2>
            {{#all_has_mediation}}
            <div class="uit-people-list">
                {{#all_mediation}}
                {{> mod_gepeminfotutoria/person_item_full }}
                {{/all_mediation}}
            </div>
            {{/all_has_mediation}}
            {{^all_has_mediation}}
            <p class="uit-empty">{{all_empty_mediation_message}}</p>
            {{/all_has_mediation}}
        </section>

        <section class="uit-full-panel">
            <h2 class="uit-role-title">{{#str}} tutoriapresencial, gepeminfotutoria {{/str}}</h2>
            {{#all_has_presential}}
            <div class="uit-people-list">
                {{#all_presential}}
                {{> mod_gepeminfotutoria/person_item_full }}
                {{/all_presential}}
            </div>
            {{/all_has_presential}}
            {{^all_has_presential}}
            <p class="uit-empty">{{all_empty_presential_message}}</p>
            {{/all_has_presential}}
        </section>
    </div>
</div>
